{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intent change record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "id",
    "title",
    "status",
    "created_at",
    "request",
    "proposal",
    "scope",
    "decisions",
    "review_required"
  ],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "changes_requested",
        "rejected",
        "approved",
        "implementing",
        "conformance_review",
        "complete"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "request": {
      "type": "string",
      "minLength": 1
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "revision", "digest"],
      "properties": {
        "path": {
          "const": "proposal.md"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included", "excluded"],
      "properties": {
        "included": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "excluded": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Optional path globs the change may touch; when present, verification rejects undeclared paths."
        }
      }
    },
    "preserved": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Behavior and tests that remain unchanged; exceptions belong in test_changes and the proposal."
    },
    "test_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind", "reason"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["added", "modified", "deleted", "skipped"]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "review_required": {
      "type": "boolean",
      "default": false,
      "description": "True only while a material human decision or repository approval is required."
    }
  }
}
