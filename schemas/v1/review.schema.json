{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Intent review evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "change_id", "reviews"],
  "properties": {
    "protocol_version": {
      "const": "1.0"
    },
    "change_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reviewer_id",
          "reviewer_authority",
          "decision",
          "proposal_digest",
          "reviewed_at",
          "constraints"
        ],
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 1
          },
          "reviewer_authority": {
            "type": "string",
            "minLength": 1
          },
          "decision": {
            "enum": ["approved", "changes_requested", "rejected"]
          },
          "proposal_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "constraints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "reference"],
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
